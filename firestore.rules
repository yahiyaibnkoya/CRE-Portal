rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isCenterAdmin(centerId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'CENTER_ADMIN' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true &&
        centerId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.centerIds;
    }

    function isCenterActive(centerId) {
      return exists(/databases/$(database)/documents/centers/$(centerId)) &&
        get(/databases/$(database)/documents/centers/$(centerId)).data.status == 'Active';
    }

    // User collection: Super Admin can read/write all; users can read their own
    match /users/{userId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow create, update, delete: if isSuperAdmin();
    }

    // Global settings: Super Admin can read/write; authenticated users can read
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Centers collection
    match /centers/{centerId} {
      allow read: if true; // Public read for student portal & directory
      allow create: if isSuperAdmin() || isAuthenticated();
      allow update, delete: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));

      // Sub-collections inside each center
      match /students/{studentId} {
        allow read: if true; // Filtered by client-side phone lookup
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /attendance/{attendanceId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /monthlyFees/{feeId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /feePayments/{paymentId} {
        allow read: if isSuperAdmin() || isCenterAdmin(centerId);
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /donations/{donationId} {
        allow read, write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /expenses/{expenseId} {
        allow read, write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /exams/{examId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /examMarks/{markId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCenterAdmin(centerId) && isCenterActive(centerId));
      }

      match /donatedContacts/{contactId} {
        allow create: if true; // Students and parents can donate contacts
        allow read, update, delete: if isSuperAdmin() || isCenterAdmin(centerId);
      }
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit logs
    }
  }
}
